{
  "redirects": [
    {
      "source": "/we-buy-gold.html",
      "destination": "/sell-gold.html",
      "permanent": true
    },
    {
      "source": "/we-buy-gold",
      "destination": "/sell-gold.html",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "destination": "/index.html",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/index.html",
      "permanent": true
    }
  ],
  "functions": {
    "api/design.js": {
      "maxDuration": 300
    },
    "api/gold-estimate.js": {
      "includeFiles": "{classic-cuban-data.js,classic-cuban-pricing.js}"
    },
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/checkout",
      "destination": "/api/gold-estimate?op=checkout"
    }
  ]
}
